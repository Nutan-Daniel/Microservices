# Copy this file to .env and fill in production values before deploying.
# Never commit .env with real secrets.

# Database URLs (SQLite for local dev, PostgreSQL for production)
USERS_DATABASE_URL=sqlite+aiosqlite:///./users.db
CATALOG_DATABASE_URL=sqlite+aiosqlite:///./catalog.db
INVENTORY_DATABASE_URL=sqlite+aiosqlite:///./inventory.db
ORDERS_DATABASE_URL=sqlite+aiosqlite:///./orders.db
PAYMENTS_DATABASE_URL=sqlite+aiosqlite:///./payments.db

# Redis
REDIS_URL=redis://redis:6379/0

# Security (change these in production)
JWT_SECRET_KEY=a3ddf51376e341d3f670f25c81113837152e88782a01bafe7169769a3be239de
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Payment provider (sandbox initially)
PAYMENT_PROVIDER=sandbox
PAYMENT_PROVIDER_URL=http://sandbox-payment-provider:9000

# Logging
LOG_LEVEL=info

